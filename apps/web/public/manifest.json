  "shortcuts": [
    {
      "name": "Start Practice Interview",
      "short_name": "Practice",
      "description": "Begin a new AI-powered interview practice session",
      "url": "/dashboard/interviews/practice",
      "icons": [
        {
          "src": "/icons/shortcut-practice.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "View Analytics",
      "short_name": "Analytics",
      "description": "Check your interview performance analytics",
      "url": "/dashboard/analytics",
      "icons": [
        {
          "src": "/icons/shortcut-analytics.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Upload Resume",
      "short_name": "Resume",
      "description": "Upload and analyze your resume",
      "url": "/dashboard/resume",
      "icons": [
        {
          "src": "/icons/shortcut-resume.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Find Expert Coach",
      "short_name": "Experts",
      "description": "Connect with expert interview coaches",
      "url": "/dashboard/experts",
      "icons": [
        {
          "src": "/icons/shortcut-experts.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.interviewspark.app",
      "id": "com.interviewspark.app"
    },
    {
      "platform": "itunes",
      "url": "https://apps.apple.com/app/interviewspark/id123456789"
    }
  ],
  "prefer_related_applications": false,
  "edge_side_panel": {
    "preferred_width": 400
  },
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "handle_links": "preferred",
  "protocol_handlers": [
    {
      "protocol": "web+interviewspark",
      "url": "/handle?url=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/dashboard/resume/upload",
      "accept": {
        "application/pdf": [".pdf"],
        "application/msword": [".doc"],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [".docx"]
      }
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "resume",
          "accept": ["application/pdf", ".pdf", "application/msword", ".doc", "application/vnd.openxmlformats-officedocument.wordprocessingml.document", ".docx"]
        }
      ]
    }
  }
}
