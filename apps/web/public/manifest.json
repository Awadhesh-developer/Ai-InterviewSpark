{
  "name": "InterviewSpark - AI-Powered Interview Preparation",
  "short_name": "InterviewSpark",
  "description": "Master your interviews with AI-powered practice, real-time feedback, and expert coaching. Prepare for technical, behavioral, and industry-specific interviews.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#3b82f6",
  "orientation": "portrait-primary",
  "scope": "/",
  "lang": "en",
  "dir": "ltr",
  "categories": ["education", "productivity", "business"],
  "screenshots": [
